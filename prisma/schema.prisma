// WanderWorld Global — v1 schema
// Deliberately trimmed to what the booking loop needs today.
// Add tables when a real feature needs them, not before.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  PAYPAL
  MPESA
  INTASEND
  NOWPAYMENTS
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  image         String?
  phone         String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  reviews       Review[]
  wishlist      WishlistItem[]
  passwordResetTokens PasswordResetToken[]
  tripsCreated  Trip[]
  tripMemberships TripMember[]
  pointsTransactions PointsTransaction[]

  @@index([email])
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  country     String
  tagline     String?
  description String?
  heroImage   String?
  createdAt   DateTime @default(now())

  hotels      Hotel[]
}

model Hotel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  city           String
  country        String
  address        String?
  latitude       Float?
  longitude      Float?
  pricePerNight  Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  amenities      String[]
  images         String[]
  // How many overlapping bookings this listing can hold per night. These
  // are boutique whole-property stays (guesthouses, riads), so 1 is the
  // realistic default — see lib/data.ts for per-hotel values.
  totalUnits     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destinationId  String
  destination    Destination @relation(fields: [destinationId], references: [id])

  bookings       Booking[]
  reviews        Review[]
  wishlistedBy   WishlistItem[]

  @@index([destinationId])
  @@index([city, country])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  hotelId        String
  hotel          Hotel         @relation(fields: [hotelId], references: [id])

  checkIn        DateTime
  checkOut       DateTime
  guests         Int           @default(1)
  nights         Int
  subtotal       Decimal       @db.Decimal(10, 2)
  serviceFee     Decimal       @db.Decimal(10, 2)
  pointsRedeemed Int           @default(0)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")

  // Optional — set when this booking was made as part of a group trip,
  // so everyone in the trip can see who's already booked and where.
  tripId         String?
  trip           Trip?         @relation(fields: [tripId], references: [id])
  pointsTransactions PointsTransaction[]

  status         BookingStatus @default(PENDING)
  guestName      String
  guestEmail     String
  guestPhone     String?

  // Set only when someone books this stay on behalf of a different
  // person — the booking still belongs to (and earns points for) the
  // guest above; these two fields just record who actually paid.
  paidByName     String?
  paidByEmail    String?
  specialRequests String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payment        Payment?
  review         Review?

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([hotelId, checkIn, checkOut])
  @@index([tripId])
}

model Payment {
  id            String          @id @default(cuid())
  bookingId     String          @unique
  booking       Booking         @relation(fields: [bookingId], references: [id])
  provider      PaymentProvider
  providerRef   String?         // Stripe session id / Paystack ref / etc.
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  status        PaymentStatus   @default(PENDING)
  rawWebhook    Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([provider, providerRef])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  @@index([hotelId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

// Only the SHA-256 hash of the raw reset token is ever stored — the raw
// token exists only in the email link and briefly in memory server-side.
// Single-use: consumed (deleted) on a successful password reset, and any
// existing token for a user is replaced whenever a new one is requested.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TripMemberStatus {
  INVITED
  JOINED
}

// A group trip: one destination, one date range, shared by everyone
// invited. Each member books their own room independently (see Booking.
// tripId) — this model coordinates who's going and who's already booked,
// it doesn't handle payment itself.
model Trip {
  id              String       @id @default(cuid())
  name            String
  destinationSlug String
  startDate       DateTime
  endDate         DateTime
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  members         TripMember[]
  bookings        Booking[]
  createdAt       DateTime     @default(now())

  @@index([createdById])
  @@index([destinationSlug])
}

// One row per invited email, whether or not they've created an account
// yet. `userId` is null until they actually join (via the emailed
// invite link), at which point it's linked and status flips to JOINED.
model TripMember {
  id              String            @id @default(cuid())
  tripId          String
  trip            Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  email           String
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  status          TripMemberStatus  @default(INVITED)
  // Same hashed-token pattern as PasswordResetToken — only the hash is
  // stored, the raw token lives only in the invite email link.
  inviteTokenHash String?           @unique
  invitedAt       DateTime          @default(now())
  joinedAt        DateTime?

  @@unique([tripId, email])
  @@index([userId])
}

enum PointsReason {
  BOOKING_EARNED
  BOOKING_REDEEMED
}

// A running ledger, not a stored balance field — the balance is always
// the sum of these rows, so it can never silently drift out of sync
// with what actually happened. `amount` is positive for an earn,
// negative for a redemption.
model PointsTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    PointsReason
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([bookingId])
}
