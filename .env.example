# Database (Neon Postgres) — Vercel serverless functions can spin up many
# concurrent instances, each potentially opening its own DB connection.
# Without pooling, this exhausts Neon's connection limit fast under real
# traffic. Neon's dashboard gives you two connection strings — use both:
#
# DATABASE_URL: the POOLED one (hostname contains "-pooler"), used by the
#   app at runtime (lib/db.ts).
# DIRECT_URL: the UNPOOLED one, used only by `prisma db push` /
#   `prisma migrate` (schema changes need a direct connection; pooled
#   connections via PgBouncer don't support the session-level features
#   migrations rely on).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Cron — protects /api/cron/cleanup-bookings from being triggered by
# anyone who finds the URL. Set to any random string (16+ chars); Vercel
# automatically sends it back as the Authorization header when the
# scheduled job in vercel.json fires. You set this value — Vercel doesn't
# generate it.
CRON_SECRET="generate-a-random-string-here"
# Google Cloud Console → Credentials → OAuth Client → Authorized redirect URI:
#   https://<your-vercel-domain>/api/auth/callback/google
#   (add http://localhost:3000/api/auth/callback/google too if testing locally)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments — all four are live implementations now (lib/payments/)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# From NOWPayments dashboard: Store Settings → API Keys / IPN Secret Key
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# PayPal — developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "live" or omit/anything else for sandbox. Keep on sandbox until you've
# tested a full booking end to end.
PAYPAL_MODE="sandbox"
# Dashboard → Apps & Credentials → your app → Webhooks → Add Webhook,
# URL: https://<your-vercel-domain>/api/webhooks/paypal
# events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.DENIED
PAYPAL_WEBHOOK_ID=""

# M-Pesa (Safaricom Daraja) — developer.safaricom.co.ke
# NOTE: STK push is KES-only. Our seed hotels are priced in USD, so
# M-Pesa checkout will send USD amounts as if they were KES until a
# currency conversion layer exists — see lib/payments/mpesa.ts.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# "live" or omit/anything else for sandbox
MPESA_MODE="sandbox"
# No dashboard webhook to configure — Daraja takes the callback URL on
# every STK push request, already wired to /api/webhooks/mpesa.

# Email — powers real booking confirmation emails (lib/email.ts)
RESEND_API_KEY=""
# Optional — defaults to Resend's shared test address if unset. Set this
# once you've verified a domain in the Resend dashboard.
# EMAIL_FROM="WanderWorld Global <bookings@yourdomain.com>"

# Media
CLOUDINARY_URL=""
# ^ Not used by any feature yet — no image upload UI exists. Hotel photos
# are currently hardcoded Unsplash URLs in lib/data.ts. Add this when an
# actual upload feature (e.g. an admin panel, or user-submitted photos)
# gets built.

# AI Planner
OPENAI_API_KEY=""

